root = true

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
trim_trailing_whitespace = true

# Files Visual Studio writes with a UTF-8 byte order mark.
[*.{cs,csproj,resx,settings,config,xml}]
charset = utf-8-bom

# Generated by the Windows Forms designer, which writes comment lines with a trailing space.
[*.Designer.cs]
trim_trailing_whitespace = false

# Written by Visual Studio without a final newline and with trailing spaces in its header.
[*.{resx,Designer.xml}]
insert_final_newline = false
trim_trailing_whitespace = false

[*.md]
trim_trailing_whitespace = false

[*.cs]
indent_style = space
indent_size = 4

[*.{csproj,slnx,xml,resx,config,settings}]
indent_style = space
indent_size = 2

[*.json]
indent_style = space
indent_size = 2
