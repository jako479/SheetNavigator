* text=auto

*.cs text diff=csharp
*.csproj text
*.slnx text
*.resx text
*.xml text
*.config text
*.settings text
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary assets: never convert line endings, never diff.
*.png binary
*.jpg binary
*.pdf binary
*.xlsx binary
*.xlsm binary
*.zip binary
*.pfx binary
*.dll binary
*.exe binary
