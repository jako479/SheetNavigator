<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <RootNamespace>SheetNavigator.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="MSTest.TestAdapter" Version="4.4.1" />
    <PackageReference Include="MSTest.TestFramework" Version="4.4.1" />
  </ItemGroup>

  <!-- The rules are compiled in directly: the add-in assembly needs the VSTO runtime, which a test host does not have. -->
  <ItemGroup>
    <Compile Include="..\SheetNavigator\PaneSizeRules.cs" Link="PaneSizeRules.cs" />
  </ItemGroup>

</Project>
